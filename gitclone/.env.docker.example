# ==============================================================================
# GitClone Docker Runtime Configuration
# NOTE: DO NOT COMMIT REAL CREDENTIALS TO GIT.
# Copy this file to '.env' before running: `docker run --env-file .env ...`
# ==============================================================================

# 1. Neon PostgreSQL Database (Required)
# Get your connection string from the Neon Console: https://console.neon.tech
# Ensure `sslmode=require` or `sslmode=verify-full` is attached to the query string.
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. Shared GitHub Personal Access Token (PAT) (Required for Multi-User Access)
# Create a fine-grained or classic PAT with `repo`, `user`, `read:org` scopes at:
# https://github.com/settings/tokens
GITHUB_PAT=ghp_yourPersonalAccessTokenHere

# 3. Security & Cryptographic Keys (Required)
# SESSION_SECRET: Minimum 32 random characters used to sign session cookies.
SESSION_SECRET=replace_with_a_secure_random_32_character_string_here_12345

# TOKEN_ENCRYPTION_KEY: 64-character hex string (32 bytes) for AES-256-GCM vault.
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 4. Server & Networking (Optional defaults)
PORT=8787
NODE_ENV=production
APP_URL=http://localhost:8787
API_URL=http://localhost:8787/api
REDIS_URL=redis://127.0.0.1:6379
