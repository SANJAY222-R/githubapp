{
  "name": "gitclone",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter @gitclone/web dev\" \"pnpm --filter @gitclone/api dev\"",
    "dev:infra": "docker compose -f infra/docker-compose.yml up -d",
    "db:generate": "pnpm --filter @gitclone/api db:generate",
    "db:migrate": "pnpm --filter @gitclone/api db:migrate",
    "db:push": "pnpm --filter @gitclone/api db:push",
    "db:studio": "pnpm --filter @gitclone/api db:studio",
    "lint": "pnpm --filter @gitclone/api lint && pnpm -r typecheck",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @gitclone/api test",
    "security:smoke": "pnpm --filter @gitclone/api exec tsx ../../scripts/security-smoke.ts",
    "build": "pnpm -r build"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0"
  }
}
