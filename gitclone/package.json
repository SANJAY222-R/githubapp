{
  "name": "gitclone",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter @gitclone/web dev\" \"pnpm --filter @gitclone/api dev\"",
    "dev:infra": "docker compose -f infra/docker-compose.yml up -d",
    "db:generate": "pnpm --filter @gitclone/api db:generate",
    "db:migrate": "pnpm --filter @gitclone/api db:migrate",
    "lint": "pnpm -r typecheck",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @gitclone/api test",
    "build": "pnpm -r build",
    "generate:key": "pnpm --filter @gitclone/api exec tsx ../../scripts/generate-key.ts",
    "smoke:test": "pnpm --filter @gitclone/api exec tsx ../../scripts/smoke-test.ts"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0"
  }
}
